---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SiteLayout from '@layouts/SiteLayout.astro';
import FormattedDate from '@components/FormattedDate.astro';
import { FEATURED_POSTS, SITE_TITLE } from '@/consts';

const allPosts = await getCollection('blog');

const posts = FEATURED_POSTS.map((id) =>
  allPosts.find((p) => p.id === id),
).filter(Boolean);
---

<SiteLayout
  title={`featured — ${SITE_TITLE}`}
  description="Hand-picked posts worth reading — projects, writing, and things I'm proud of."
>
  <section class="page-container py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-1.5">
      <span class="font-mono text-[10px] tracking-[0.2em] text-highlight/50"
        >featured /</span
      >
      <h1 class="text-4xl font-bold tracking-tight leading-none">picks</h1>
      <p class="font-mono text-[11px] text-(--text-secondary)/50 mt-0.5">
        hand-picked posts worth reading [{posts.length}]
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {
        posts.map((post, i) => (
          <li data-animate style={`--animate-delay: ${i * 60}ms`}>
            <a
              href={`/blog/${post!.id}/`}
              class="group flex flex-col rounded-xl bg-(--bg-secondary) no-underline overflow-hidden shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 h-full"
            >
              {post!.data.heroImage && (
                <div class="overflow-hidden h-44 shrink-0">
                  <Image
                    width={600}
                    height={280}
                    src={post!.data.heroImage}
                    alt={post!.data.heroImageAlt ?? post!.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                </div>
              )}
              <div class="flex flex-col gap-3 p-6 flex-1">
                {post!.data.category && (
                  <span class="font-mono text-[10px] tracking-widest text-highlight opacity-90">
                    {post!.data.category}
                  </span>
                )}
                <p class="font-mono text-sm leading-snug transition-colors group-hover:text-highlight line-clamp-2">
                  {post!.data.title}
                </p>
                {post!.data.description && (
                  <p class="font-mono text-xs text-(--text-secondary) line-clamp-2 leading-relaxed">
                    {post!.data.description}
                  </p>
                )}
                <span class="font-mono text-[11px] text-(--text-secondary)/60 mt-auto pt-1">
                  <FormattedDate date={post!.data.pubDate} />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="border-t border-(--text-secondary)/10 pt-6">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-lg bg-(--bg-secondary) px-4 py-2 font-mono text-xs text-(--text-secondary) no-underline shadow-(--box-shadow) transition-all duration-200 hover:text-highlight hover:-translate-y-0.5"
      >
        ← all posts
      </a>
    </div>
  </section>
</SiteLayout>
