---
import { getCollection } from 'astro:content'
import SiteLayout from '@layouts/SiteLayout.astro'
import FormattedDate from '@components/FormattedDate.astro'
import { FEATURED_POSTS, SITE_TITLE } from '@/consts'

const allPosts = await getCollection('blog')

const posts = FEATURED_POSTS.map((id) =>
  allPosts.find((p) => p.id === id),
).filter(Boolean)
---

<SiteLayout
  title={`featured — ${SITE_TITLE}`}
  description="Hand-picked posts worth reading — projects, writing, and things I'm proud of."
>
  <section class="page-container py-16 flex flex-col gap-6">
    <div class="flex flex-col gap-2">
      <span class="font-mono text-xs text-highlight">featured</span>
      <h1 class="text-section font-semibold">picks</h1>
      <p class="font-mono text-xs text-text-tertiary">
        hand-picked posts worth reading [{posts.length}]
      </p>
    </div>

    <ul
      class="flex flex-col divide-y divide-(--text-secondary)/10 border-t border-b border-(--text-secondary)/10"
    >
      {
        posts.map((post, i) => (
          <li data-animate style={`--animate-delay: ${i * 50}ms`}>
            <a
              href={`/blog/${post!.id}/`}
              class="group flex flex-col sm:flex-row sm:items-baseline sm:gap-6 py-4 no-underline"
            >
              <span class="text-sm text-text-primary group-hover:text-highlight transition-colors flex-1">
                {post!.data.title}
              </span>
              {post!.data.category && (
                <span class="font-mono text-xs text-text-tertiary shrink-0 hidden sm:block">
                  {post!.data.category}
                </span>
              )}
              <span class="font-mono text-xs text-text-tertiary shrink-0">
                <FormattedDate date={post!.data.pubDate} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/blog"
      class="font-mono text-xs text-highlight no-underline w-fit hover:underline"
    >
      ← all posts
    </a>
  </section>
</SiteLayout>
