---
import SiteLayout from '@layouts/SiteLayout.astro'
import { SITE_TITLE } from '@/consts'
---

<SiteLayout
  title={`404 — ${SITE_TITLE}`}
  description="This page doesn't exist."
>
  <section
    class="page-container flex flex-1 flex-col items-center justify-center gap-8 py-28 text-center"
  >
    <div class="flex flex-col gap-3">
      <span class="font-mono text-xs text-highlight">error</span>
      <h1 class="text-hero-name font-semibold text-text-primary">404</h1>
      <p class="text-sm text-text-secondary">
        this page doesn't exist or was moved.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-6">
      <a
        href="/"
        class="font-mono text-xs text-highlight no-underline hover:underline"
      >
        ← home
      </a>
      <a
        href="/blog"
        class="font-mono text-xs text-highlight no-underline hover:underline"
      >
        blog
      </a>
    </div>
  </section>
</SiteLayout>
