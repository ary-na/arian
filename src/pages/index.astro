---
import SiteLayout from "@layouts/SiteLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const latest = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* Hero section */}
  <section class="page-container space-y-6 pt-15">
    <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
      developer . melbourne
      <span class="align-middle">🇦🇺</span><img
        src="https://cdn.jsdelivr.net/gh/twitter/twemoji@latest/assets/svg/1f1ee-1f1f7.svg"
        alt="Iranian imperial flag"
        class="inline-block align-middle"
        style="width: 1.2em; height: 1.2em;"
      /> . ai systems
    </span>

    <h1 class="text-5xl font-bold">
      <span data-typewriter="hi, i'm arian"></span>
      <span class="animate-blink">_</span>
    </h1>

    <p class="text-lg max-w-lg">
      I write about what I'm learning, what I'm building, and the systems I
      work with.
    </p>

    <p class="text-sm italic text-(--text-secondary)">
      Mostly AI/ML, Swift, and whatever rabbit hole I fell into this week.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="/about"
        class="group inline-flex items-center gap-2 rounded-lg bg-(--bg-secondary) px-4 py-2 font-mono text-xs shadow-(--box-shadow) no-underline transition-all duration-200 hover:text-highlight hover:shadow-md hover:-translate-y-0.5"
      >
        <span class="text-highlight">→</span>
        about me
      </a>
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 rounded-lg bg-(--bg-secondary) px-4 py-2 font-mono text-xs shadow-(--box-shadow) no-underline transition-all duration-200 hover:text-highlight hover:shadow-md hover:-translate-y-0.5"
      >
        <span class="text-highlight">→</span>
        read the blog
      </a>
    </div>
  </section>

  {/* Latest posts section */}
  <section class="page-container py-15 space-y-6">
    <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
      things I'm building and figuring out
    </span>

    <h2 class="mb-4 flex text-3xl items-center gap-2 after:h-px after:flex-1">
      latest posts
      <span class="text-highlight">[{posts.length}]</span>
    </h2>

    <ul class="flex flex-col gap-3">
      {
        latest.map((post) => (
          <li>
            <a
              href={`/blog/${post.id.replace(/\.mdx?$/, "")}`}
              class="group grid grid-cols-[1fr_auto] items-start gap-4 rounded-lg bg-(--bg-secondary) px-4 py-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
            >
              {/* Title + Description */}
              <div class="flex min-w-0 flex-col gap-1.5">
                {post.data.category && (
                  <span class="font-mono text-[10px] text-highlight opacity-90">
                    {post.data.category}
                  </span>
                )}
                <p class="truncate font-mono text-sm transition-colors group-hover:text-highlight">
                  {post.data.title}
                </p>
                {post.data.description && (
                  <p class="truncate font-mono text-xs text-(--text-tertiary)">
                    {post.data.description}
                  </p>
                )}
              </div>

              {/* Date */}
              <div class="shrink-0 text-right">
                <span class="font-mono text-[11px] text-(--text-tertiary)">
                  {post.data.pubDate.toLocaleDateString("en-AU", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* More section */}
  <section class="py-15">
    <div class="page-container space-y-6">
      <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
        keep exploring
      </span>

      <h2 class="mb-4 flex text-3xl items-center gap-2 after:h-px after:flex-1">
        more
      </h2>

      <div class="grid grid-cols-2 gap-3">
        <a
          href="/blog"
          class="group rounded-lg bg-(--bg-secondary) px-4 py-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
        >
          <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">all posts</p>
          <p class="mt-1 font-mono text-[10px] text-(--text-tertiary)">read everything</p>
        </a>
        <a
          href="/blog/category/project"
          class="group rounded-lg bg-(--bg-secondary) px-4 py-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
        >
          <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">projects</p>
          <p class="mt-1 font-mono text-[10px] text-(--text-tertiary)">see what i built</p>
        </a>
      </div>
    </div>
  </section>

  {/* Find me section */}
  <section class="page-container py-15 space-y-6">
    <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
      elsewhere on the web
    </span>

    <h2 class="mb-4 flex text-3xl items-center gap-2 after:h-px after:flex-1">
      find me
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a
        href="https://x.com/ariiii4n"
        class="group rounded-lg bg-(--bg-secondary) px-4 py-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
      >
        <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">x / twitter</p>
        <p class="mt-1 font-mono text-[10px] text-(--text-tertiary) truncate">@ariiii4n</p>
      </a>
      <a
        href="https://github.com/ary-na"
        class="group rounded-lg bg-(--bg-secondary) px-4 py-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
      >
        <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">github</p>
        <p class="mt-1 font-mono text-[10px] text-(--text-tertiary) truncate">ary-na</p>
      </a>
      <a
        href="https://linkedin.com/in/arian-najafi-yamchelo"
        class="group rounded-lg bg-(--bg-secondary) px-4 py-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
      >
        <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">linkedin</p>
        <p class="mt-1 font-mono text-[10px] text-(--text-tertiary) truncate">arian-najafi-yamchelo</p>
      </a>
      <a
        href="https://gravatar.com/collectiveautomaticae806d67f2"
        class="group rounded-lg bg-(--bg-secondary) px-4 py-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
      >
        <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">gravatar</p>
        <p class="mt-1 font-mono text-[10px] text-(--text-tertiary) truncate">collectiveautomaticae806d67f2</p>
      </a>
    </div>
  </section>
</SiteLayout>

<script>
  import { initTypewriter } from "@/scripts/typewriter";

  document.addEventListener("astro:page-load", () => {
    initTypewriter();
  });

  initTypewriter();
</script>
