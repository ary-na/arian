---
import SiteLayout from '@layouts/SiteLayout.astro'
import FormattedDate from '@components/FormattedDate.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const latest = posts.slice(0, 5)
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* Hero */}
  <section class="page-container pt-24 pb-20 md:pt-32 md:pb-28">
    <span class="block font-mono text-xs text-highlight mb-5">arii</span>
    <h1 class="text-hero-name font-semibold leading-tight mb-5">
      Arian Najafi Yamchelo
    </h1>
    <p class="max-w-xl text-text-secondary leading-relaxed">
      I'm Arian — I build full-stack apps and machine learning systems, most
      recently <a
        href="/blog/lazy-commit"
        class="text-highlight underline decoration-(--highlight)/30 underline-offset-2 hover:decoration-(--highlight)"
        >lazy-commit</a
      > and <a
        href="/blog/hushlink"
        class="text-highlight underline decoration-(--highlight)/30 underline-offset-2 hover:decoration-(--highlight)"
        >hushlink</a
      >. I write about the process on the <a
        href="/blog"
        class="text-highlight underline decoration-(--highlight)/30 underline-offset-2 hover:decoration-(--highlight)"
        >blog</a
      >.
    </p>
    <p class="mt-4 font-mono text-xs text-text-tertiary">
      currently — finishing a Master's in AI at Monash, open to grad roles
    </p>
  </section>

  {/* Writing */}
  <section class="page-container py-14 flex flex-col gap-6">
    <h2 class="text-section font-semibold">
      writing <span class="text-text-tertiary font-mono text-sm font-normal"
        >[{posts.length}]</span
      >
    </h2>
    <ul
      class="flex flex-col divide-y divide-(--text-secondary)/10 border-t border-b border-(--text-secondary)/10"
    >
      {
        latest.map((post, i) => (
          <li data-animate style={`--animate-delay: ${i * 60}ms`}>
            <a
              href={`/blog/${post.id}/`}
              class="group flex flex-col sm:flex-row sm:items-baseline sm:gap-6 py-4 no-underline"
            >
              <span class="text-sm text-text-primary group-hover:text-highlight transition-colors flex-1">
                {post.data.title}
              </span>
              {post.data.category && (
                <span class="font-mono text-xs text-text-tertiary shrink-0 hidden sm:block">
                  {post.data.category}
                </span>
              )}
              <span class="font-mono text-xs text-text-tertiary shrink-0">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex gap-6">
      <a
        href="/blog"
        class="font-mono text-xs text-highlight no-underline w-fit hover:underline"
      >
        all posts →
      </a>
      <a
        href="/featured"
        class="font-mono text-xs text-highlight no-underline w-fit hover:underline"
      >
        featured picks →
      </a>
    </div>
  </section>
</SiteLayout>
