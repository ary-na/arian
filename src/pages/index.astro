---
import SiteLayout from '@layouts/SiteLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SHIPPED, SOCIAL_LINKS, TECH_STACK } from '@/consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const latest = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* Hero section */}
  <section class="page-container py-28 md:py-36">
    <div class="mb-8 flex flex-wrap items-center gap-2">
      <span class="rounded-full border border-(--text-secondary)/15 bg-(--bg-secondary) px-3 py-1 font-mono text-[10px] tracking-widest text-(--text-secondary)">
        developer
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-(--text-secondary)/15 bg-(--bg-secondary) px-3 py-1 font-mono text-[10px] tracking-widest text-(--text-secondary)">
        <span>🇦🇺</span><img
          src="https://cdn.jsdelivr.net/gh/twitter/twemoji@latest/assets/svg/1f1ee-1f1f7.svg"
          alt="Iranian imperial flag"
          class="inline-block"
          style="width: 1em; height: 1em;"
        />
        melbourne
      </span>
      <span class="rounded-full border border-(--text-secondary)/15 bg-(--bg-secondary) px-3 py-1 font-mono text-[10px] tracking-widest text-(--text-secondary)">
        ai systems
      </span>
    </div>

    <h1 class="mb-6 text-6xl font-bold leading-tight tracking-tight sm:text-7xl">
      <span data-typewriter="hi, i'm arian"></span><span class="animate-blink text-highlight">_</span>
    </h1>

    <p class="mb-10 max-w-sm text-base leading-relaxed text-(--text-secondary)">
      I write about what I'm learning, building, and obsessing over — mostly AI/ML,
      Swift, and whatever rabbit hole I fell into this week.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="/about"
        class="inline-flex items-center gap-2 rounded-lg border border-(--highlight)/25 bg-(--highlight)/10 px-5 py-2.5 font-mono text-xs text-highlight no-underline transition-all duration-200 hover:bg-(--highlight)/15 hover:-translate-y-0.5"
      >
        about me <span class="opacity-60">→</span>
      </a>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-lg border border-(--text-secondary)/10 bg-(--bg-secondary) px-5 py-2.5 font-mono text-xs shadow-(--box-shadow) no-underline transition-all duration-200 hover:text-highlight hover:-translate-y-0.5"
      >
        read the blog <span class="opacity-60">→</span>
      </a>
    </div>
  </section>

  {/* Shipped section */}
  <section class="page-container py-20 flex flex-col gap-8">
    <div class="flex flex-col gap-2">
      <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
        <span class="text-highlight/50">//</span> tools i've built and use daily
      </span>
      <h2 class="flex text-3xl items-center gap-3 scroll-gradient-line after:h-px after:flex-1">
shipped
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        SHIPPED.map((item, i) => (
          <a
            data-animate
            style={`--animate-delay: ${i * 80}ms`}
            href={item.href}
            class="group flex flex-col gap-3 rounded-xl bg-(--bg-secondary) px-5 py-5 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
          >
            <div class="flex items-center justify-between gap-2">
              <p class="font-mono text-sm text-(--text-primary) transition-colors group-hover:text-highlight">
                {item.name}
              </p>
              <span class="font-mono text-[10px] text-(--text-secondary)/60 shrink-0">
                {item.tag}
              </span>
            </div>
            <p class="font-mono text-xs text-(--text-secondary) leading-relaxed">
              {item.description}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  {/* Tech stack section */}
  <section class="w-full py-20 flex flex-col gap-8">
    <div class="page-container flex flex-col gap-2">
      <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
        <span class="text-highlight/50">//</span> things i build with
      </span>
      <h2 class="flex text-3xl items-center gap-3 scroll-gradient-line after:h-px after:flex-1">
stack
      </h2>
    </div>

    <div
      class="w-full border-y border-(--text-secondary)/10 py-25"
      style="background: color-mix(in srgb, var(--bg-secondary) 45%, transparent); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
    >
      <div
        class="overflow-hidden"
        style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);"
      >
        <div
          class="marquee-track flex"
          style="animation: marquee var(--marquee-duration, 30s) linear infinite;"
          onmouseenter="this.style.animationPlayState='paused'"
          onmouseleave="this.style.animationPlayState='running'"
        >
          {
            [...TECH_STACK, ...TECH_STACK].map((tech) => (
              <div class="group flex shrink-0 flex-col items-center gap-3 px-10 sm:px-14">
                <img
                  src={`https://cdn.simpleicons.org/${tech.icon}`}
                  alt={tech.name}
                  width="28"
                  height="28"
                  class="tech-icon h-7 w-7"
                />
                <span class="font-mono text-[9px] whitespace-nowrap text-(--text-tertiary) transition-colors duration-200 group-hover:text-(--text-secondary)">
                  {tech.name}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* Latest posts section */}
  <section class="page-container py-20 flex flex-col gap-8">
    <div class="flex flex-col gap-2">
      <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
        <span class="text-highlight/50">//</span> things I'm building and figuring out
      </span>
      <h2 class="flex text-3xl items-center gap-3 scroll-gradient-line after:h-px after:flex-1">
latest posts
        <span class="text-highlight">[{posts.length}]</span>
      </h2>
    </div>

    <ul class="flex flex-col gap-4">
      {
        latest.map((post, i) => (
          <li data-animate style={`--animate-delay: ${i * 60}ms`}>
            <a
              href={`/blog/${post.id}`}
              class="group grid grid-cols-[1fr_auto] items-start gap-4 rounded-xl bg-(--bg-secondary) px-5 py-5 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
            >
              <div class="flex min-w-0 flex-col gap-2">
                {post.data.category && (
                  <span class="font-mono text-[10px] text-highlight opacity-90">
                    {post.data.category}
                  </span>
                )}
                <p class="truncate font-mono text-sm transition-colors group-hover:text-highlight">
                  {post.data.title}
                </p>
                {post.data.description && (
                  <p class="truncate font-mono text-xs text-(--text-tertiary)">
                    {post.data.description}
                  </p>
                )}
              </div>

              <div class="shrink-0 text-right">
                <span class="font-mono text-[11px] text-(--text-tertiary)">
                  {post.data.pubDate.toLocaleDateString('en-AU', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* More section */}
  <section class="py-20">
    <div class="page-container flex flex-col gap-8">
      <div class="flex flex-col gap-2">
        <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
          <span class="text-highlight/50">//</span> keep exploring
        </span>
        <h2 class="flex text-3xl items-center gap-3 scroll-gradient-line after:h-px after:flex-1">
    more
        </h2>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <a
          data-animate
          href="/blog"
          class="group rounded-xl bg-(--bg-secondary) px-5 py-5 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
        >
          <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">
            all posts
          </p>
          <p class="mt-1.5 font-mono text-[10px] text-(--text-tertiary)">
            read everything
          </p>
        </a>
        <a
          data-animate
          style="--animate-delay: 80ms"
          href="/blog/category/project"
          class="group rounded-xl bg-(--bg-secondary) px-5 py-5 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
        >
          <p class="font-mono text-xs text-(--text-primary) group-hover:text-highlight transition-colors">
            projects
          </p>
          <p class="mt-1.5 font-mono text-[10px] text-(--text-tertiary)">
            see what i built
          </p>
        </a>
      </div>
    </div>
  </section>

  {/* Find me section */}
  <section class="page-container py-20 flex flex-col gap-8">
    <div class="flex flex-col gap-2">
      <span class="font-mono text-xs tracking-widest text-(--text-secondary)">
        <span class="text-highlight/50">//</span> elsewhere on the web
      </span>
      <h2 class="flex text-3xl items-center gap-3 scroll-gradient-line after:h-px after:flex-1">
find me
      </h2>
    </div>

    <div class="flex flex-col divide-y divide-(--text-secondary)/10 overflow-hidden rounded-xl border border-(--text-secondary)/10">
      {
        SOCIAL_LINKS.map((link, i) => (
          <a
            data-animate
            style={`--animate-delay: ${i * 55}ms`}
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
            class="group flex items-center justify-between gap-4 bg-(--bg-secondary) px-5 py-5 no-underline transition-all duration-300 hover:bg-(--highlight)/8 hover:pl-7"
          >
            <span class="font-mono text-sm text-text-primary transition-colors duration-200 group-hover:text-highlight">
              {link.label}
            </span>
            <span class="hidden font-mono text-xs text-(--text-tertiary) sm:block">
              {link.handle}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  @media (max-width: 639px) {
    :root { --marquee-duration: 15s; }
  }

  .scroll-gradient-line::after {
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--highlight) 50%, transparent) 50%,
      transparent 100%
    );
    background-size: 250% 100%;
    animation: line-shimmer 5s ease-in-out infinite alternate;
  }

  @keyframes line-shimmer {
    from { background-position: 0% 0; }
    to   { background-position: 100% 0; }
  }
</style>

<script>
  import { initTypewriter } from '@/scripts/typewriter';

  document.addEventListener('astro:page-load', () => {
    initTypewriter();
  });

  initTypewriter();
</script>
