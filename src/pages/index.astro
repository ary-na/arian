---
import SiteLayout from '@layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  SHIPPED,
  SOCIAL_LINKS,
  TECH_STACK,
} from '@/consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const latest = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* Hero section */}
  <section
    class="mx-auto w-full max-w-5xl px-6 md:px-10 py-28 md:py-36 relative"
  >
    {/* Floating terminal — desktop only */}
    <div
      class="hidden lg:flex flex-col absolute right-0 top-1/2 -translate-y-1/2 w-[340px] xl:w-[360px] rounded-xl border border-(--text-secondary)/10 bg-(--bg-secondary)/70 backdrop-blur-sm overflow-hidden shadow-(--box-shadow)"
    >
      <div
        class="flex items-center gap-1.5 px-4 py-3 border-b border-(--text-secondary)/8"
      >
        <span class="h-2 w-2 rounded-full bg-red-400/50"></span>
        <span class="h-2 w-2 rounded-full bg-yellow-400/50"></span>
        <span class="h-2 w-2 rounded-full bg-green-400/50"></span>
        <span class="ml-2 font-mono text-[9px] text-(--text-secondary)/30"
          >terminal</span
        >
      </div>
      <div
        class="p-4 font-mono text-[11px] leading-loose flex flex-col gap-0.5"
      >
        <div>
          <span class="text-highlight/60">$</span><span
            class="text-(--text-secondary)/50 ml-1.5">whoami</span>
        </div>
        <div class="text-(--text-secondary)/80 pl-4">arian — developer</div>

        <div class="pt-1">
          <span class="text-highlight/60">$</span><span
            class="text-(--text-secondary)/50 ml-1.5">ls shipped/</span>
        </div>
        {
          SHIPPED.map((item) => (
            <div class="text-highlight/50 pl-4">{item.name}</div>
          ))
        }

        <div class="pt-1">
          <span class="text-highlight/60">$</span><span
            class="text-(--text-secondary)/50 ml-1.5">wc -l posts/*</span>
        </div>
        <div class="text-(--text-secondary)/80 pl-4">
          {posts.length} entries
        </div>

        <div class="pt-2 flex items-center gap-1">
          <span class="text-highlight/60">$</span>
          <span class="h-3 w-1.5 bg-highlight/40 animate-pulse ml-1.5"></span>
        </div>
      </div>
    </div>

    {/* Content */}
    <div class="lg:max-w-[55%]">
      <div class="mb-6 flex flex-wrap items-center gap-2">
        <span
          class="rounded-full border border-(--text-secondary)/15 bg-(--bg-secondary) px-3 py-1 font-mono text-[10px] tracking-widest text-(--text-secondary)"
        >
          developer
        </span>
        <span
          class="inline-flex items-center gap-1.5 rounded-full border border-(--text-secondary)/15 bg-(--bg-secondary) px-3 py-1 font-mono text-[10px] tracking-widest text-(--text-secondary)"
        >
          <span>🇦🇺</span><img
            src="https://cdn.jsdelivr.net/gh/twitter/twemoji@latest/assets/svg/1f1ee-1f1f7.svg"
            alt="Iranian flag"
            class="inline-block"
            style="width: 1em; height: 1em;"
          />
          melbourne
        </span>
        <span
          class="rounded-full border border-(--text-secondary)/15 bg-(--bg-secondary) px-3 py-1 font-mono text-[10px] tracking-widest text-(--text-secondary)"
        >
          ai systems
        </span>
      </div>

      <h1
        class="mb-6 text-6xl font-bold leading-tight tracking-tight sm:text-7xl"
      >
        <span data-typewriter="hi, i'm arian"></span><span
          class="animate-blink text-highlight">_</span
        >
      </h1>

      <p
        class="mb-10 max-w-sm text-base leading-relaxed text-(--text-secondary)"
      >
        I write about what I'm learning, building, and obsessing over — mostly
        AI/ML, Swift, and whatever rabbit hole I fell into this week.
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href="/about"
          class="inline-flex items-center gap-2 rounded-lg border border-(--highlight)/25 bg-(--highlight)/10 px-5 py-2.5 font-mono text-xs text-highlight no-underline transition-all duration-200 hover:bg-(--highlight)/15 hover:-translate-y-0.5"
        >
          about me <span class="opacity-60">→</span>
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-lg border border-(--text-secondary)/10 bg-(--bg-secondary) px-5 py-2.5 font-mono text-xs shadow-(--box-shadow) no-underline transition-all duration-200 hover:text-highlight hover:-translate-y-0.5"
        >
          read the blog <span class="opacity-60">→</span>
        </a>
      </div>

      <div class="mt-12 flex items-center gap-6">
        <div>
          <p class="font-display text-2xl font-bold">{posts.length}</p>
          <p class="font-mono text-[10px] text-(--text-secondary)/50 mt-0.5">
            posts
          </p>
        </div>
        <div class="h-8 w-px bg-(--text-secondary)/10"></div>
        <div>
          <p class="font-display text-2xl font-bold">{SHIPPED.length}</p>
          <p class="font-mono text-[10px] text-(--text-secondary)/50 mt-0.5">
            tools shipped
          </p>
        </div>
        <div class="h-8 w-px bg-(--text-secondary)/10"></div>
        <div>
          <p class="font-display text-2xl font-bold">5+</p>
          <p class="font-mono text-[10px] text-(--text-secondary)/50 mt-0.5">
            yrs building
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Shipped section */}
  <section class="page-container py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-1.5">
      <span class="font-mono text-[10px] tracking-[0.2em] text-highlight/50"
        >01 /</span
      >
      <h2 class="text-4xl font-bold tracking-tight leading-none">shipped</h2>
      <p class="font-mono text-[11px] text-(--text-secondary)/50 mt-0.5">
        tools i've built and use daily
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {
        SHIPPED.map((item, i) => (
          <a
            data-animate
            style={`--animate-delay: ${i * 80}ms`}
            href={item.href}
            class:list={[
              'group flex flex-col gap-4 rounded-xl bg-(--bg-secondary) px-6 py-6 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5',
              i === 0 &&
                'sm:col-span-2 sm:flex-row sm:items-center sm:gap-8 sm:py-8',
            ]}
          >
            <div
              class:list={[
                'flex items-center justify-between gap-2',
                i === 0 &&
                  'sm:flex-col sm:items-start sm:gap-1 sm:w-48 sm:shrink-0',
              ]}
            >
              <p class="font-mono text-sm text-(--text-primary) transition-colors group-hover:text-highlight">
                {item.name}
              </p>
              <span class="font-mono text-[10px] text-(--text-secondary)/60 shrink-0">
                {item.tag}
              </span>
            </div>
            <p
              class:list={[
                'font-mono text-xs text-(--text-secondary) leading-relaxed',
                i === 0 &&
                  'sm:border-l sm:border-(--text-secondary)/10 sm:pl-8',
              ]}
            >
              {item.description}
            </p>
          </a>
        ))
      }
      <a
        data-animate
        style={`--animate-delay: ${SHIPPED.length * 80}ms`}
        href="/featured"
        class="group flex flex-col justify-between rounded-xl bg-(--highlight)/8 border border-(--highlight)/15 px-5 py-5 no-underline transition-all duration-200 hover:bg-(--highlight)/12 hover:-translate-y-0.5"
      >
        <p
          class="font-mono text-[10px] text-highlight/50 tracking-widest uppercase"
        >
          curated
        </p>
        <div class="mt-4 flex items-end justify-between gap-4">
          <div>
            <p class="font-mono text-sm text-highlight">see featured</p>
            <p class="mt-1 font-mono text-[10px] text-highlight/50">
              hand-picked posts worth reading →
            </p>
          </div>
        </div>
      </a>
    </div>
  </section>

  {/* Tech stack section */}
  <section class="w-full py-16 flex flex-col gap-8">
    <div
      class="w-full border-y border-(--text-secondary)/10"
      style="background: color-mix(in srgb, var(--bg-secondary) 45%, transparent); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);"
    >
      <div
        class="overflow-hidden pt-28"
        style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);"
      >
        <div
          class="marquee-track flex"
          style="animation: marquee var(--marquee-duration, 30s) linear infinite;"
          onmouseenter="this.style.animationPlayState='paused'"
          onmouseleave="this.style.animationPlayState='running'"
        >
          {
            [...TECH_STACK, ...TECH_STACK].map((tech) => (
              <div class="group flex shrink-0 flex-col items-center gap-3 px-10 sm:px-14">
                <img
                  src={`https://cdn.simpleicons.org/${tech.icon}`}
                  alt={tech.name}
                  width="28"
                  height="28"
                  loading="lazy"
                  class="tech-icon h-7 w-7"
                />
                <span class="font-mono text-[9px] whitespace-nowrap text-(--text-tertiary) transition-colors duration-200 group-hover:text-(--text-secondary)">
                  {tech.name}
                </span>
              </div>
            ))
          }
        </div>
      </div>
      <p
        class="py-12 text-center font-mono text-[10px] tracking-widest text-(--text-secondary)/40"
      >
        # things i build with
      </p>
    </div>
  </section>

  {/* Latest posts section */}
  <section class="page-container py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-1.5">
      <span class="font-mono text-[10px] tracking-[0.2em] text-highlight/50"
        >02 /</span
      >
      <h2 class="text-4xl font-bold tracking-tight leading-none">
        latest posts <span class="text-highlight text-2xl font-mono font-normal"
          >[{posts.length}]</span
        >
      </h2>
      <p class="font-mono text-[11px] text-(--text-secondary)/50 mt-0.5">
        things i'm building and figuring out
      </p>
    </div>

    <div class="flex flex-col gap-5">
      {/* Featured first post */}
      {
        latest[0] && (
          <a
            data-animate
            href={`/blog/${latest[0].id}`}
            class="group flex flex-col sm:flex-row rounded-xl bg-(--bg-secondary) no-underline overflow-hidden shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
          >
            {latest[0].data.heroImage && (
              <div class="h-44 sm:h-auto sm:w-[38%] shrink-0 overflow-hidden">
                <Image
                  width={600}
                  height={340}
                  src={latest[0].data.heroImage}
                  alt={latest[0].data.heroImageAlt ?? latest[0].data.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
            )}
            <div class="flex flex-col justify-center gap-4 p-7 flex-1 min-w-0">
              {latest[0].data.category && (
                <span class="font-mono text-[10px] text-highlight opacity-90">
                  {latest[0].data.category}
                </span>
              )}
              <p class="font-mono text-base leading-relaxed transition-colors group-hover:text-highlight">
                {latest[0].data.title}
              </p>
              {latest[0].data.description && (
                <p class="font-mono text-xs text-(--text-secondary) leading-loose line-clamp-2">
                  {latest[0].data.description}
                </p>
              )}
              <span class="font-mono text-[11px] text-(--text-secondary)/60">
                {latest[0].data.pubDate.toLocaleDateString('en-AU', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </span>
            </div>
          </a>
        )
      }

      {/* Middle two posts — card grid */}
      {
        latest.length > 1 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {latest.slice(1, 3).map((post, i) => (
              <a
                data-animate
                style={`--animate-delay: ${(i + 1) * 60}ms`}
                href={`/blog/${post.id}`}
                class="group flex flex-col rounded-xl bg-(--bg-secondary) no-underline overflow-hidden shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
              >
                {post.data.heroImage && (
                  <div class="h-44 overflow-hidden shrink-0">
                    <Image
                      width={480}
                      height={180}
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt ?? post.data.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    />
                  </div>
                )}
                <div class="flex flex-col gap-3 p-6 flex-1">
                  {post.data.category && (
                    <span class="font-mono text-[10px] text-highlight opacity-90">
                      {post.data.category}
                    </span>
                  )}
                  <p class="font-mono text-xs leading-relaxed transition-colors group-hover:text-highlight line-clamp-2">
                    {post.data.title}
                  </p>
                  <span class="font-mono text-[11px] text-(--text-secondary)/60 mt-auto pt-2">
                    {post.data.pubDate.toLocaleDateString('en-AU', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </span>
                </div>
              </a>
            ))}
          </div>
        )
      }

      {/* Remaining posts — slim list rows */}
      {
        latest.length > 3 && (
          <div class="flex flex-col divide-y divide-(--text-secondary)/8 border border-(--text-secondary)/10 rounded-xl overflow-hidden">
            {latest.slice(3).map((post, i) => (
              <a
                data-animate
                style={`--animate-delay: ${(i + 3) * 60}ms`}
                href={`/blog/${post.id}`}
                class="group flex items-center justify-between gap-4 bg-(--bg-secondary) px-6 py-5 no-underline transition-all duration-200 hover:bg-(--highlight)/5 hover:pl-7"
              >
                <div class="flex items-center gap-3 min-w-0">
                  {post.data.category && (
                    <span class="font-mono text-[10px] text-highlight/70 shrink-0 hidden sm:block">
                      {post.data.category}
                    </span>
                  )}
                  <p class="font-mono text-xs text-(--text-primary) truncate transition-colors group-hover:text-highlight">
                    {post.data.title}
                  </p>
                </div>
                <span class="font-mono text-[11px] text-(--text-secondary)/50 shrink-0">
                  {post.data.pubDate.toLocaleDateString('en-AU', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  {/* More section */}
  <section class="py-16">
    <div class="page-container flex flex-col gap-8">
      <div class="flex flex-col gap-1.5">
        <span class="font-mono text-[10px] tracking-[0.2em] text-highlight/50"
          >03 /</span
        >
        <h2 class="text-4xl font-bold tracking-tight leading-none">more</h2>
        <p class="font-mono text-[11px] text-(--text-secondary)/50 mt-0.5">
          keep exploring
        </p>
      </div>

      <div class="grid grid-cols-3 gap-4">
        <a
          data-animate
          href="/blog"
          class="group col-span-2 flex flex-col justify-between rounded-xl bg-(--bg-secondary) px-6 py-7 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 min-h-[120px]"
        >
          <p
            class="font-mono text-[10px] text-(--text-secondary)/50 tracking-widest uppercase"
          >
            blog
          </p>
          <div>
            <p
              class="font-mono text-sm text-(--text-primary) group-hover:text-highlight transition-colors"
            >
              all posts
            </p>
            <p class="mt-1 font-mono text-[10px] text-(--text-tertiary)">
              {posts.length} entries and counting →
            </p>
          </div>
        </a>
        <a
          data-animate
          style="--animate-delay: 80ms"
          href="/blog/category/project"
          class="group flex flex-col justify-between rounded-xl bg-(--highlight)/8 border border-(--highlight)/15 px-5 py-7 no-underline transition-all duration-200 hover:bg-(--highlight)/12 hover:-translate-y-0.5 min-h-[120px]"
        >
          <p
            class="font-mono text-[10px] text-highlight/50 tracking-widest uppercase"
          >
            work
          </p>
          <div>
            <p class="font-mono text-sm text-highlight transition-colors">
              projects
            </p>
            <p class="mt-1 font-mono text-[10px] text-highlight/50">
              see what i built →
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* Find me section */}
  <section class="page-container py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-1.5">
      <span class="font-mono text-[10px] tracking-[0.2em] text-highlight/50"
        >04 /</span
      >
      <h2 class="text-4xl font-bold tracking-tight leading-none">find me</h2>
      <p class="font-mono text-[11px] text-(--text-secondary)/50 mt-0.5">
        elsewhere on the web
      </p>
    </div>

    <div
      class="flex flex-col divide-y divide-(--text-secondary)/10 overflow-hidden rounded-xl border border-(--text-secondary)/10"
    >
      {
        SOCIAL_LINKS.map((link, i) => (
          <a
            data-animate
            style={`--animate-delay: ${i * 55}ms`}
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : '_blank'}
            rel={
              link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'
            }
            class="group flex items-center justify-between gap-4 bg-(--bg-secondary) px-5 py-6 no-underline transition-all duration-300 hover:bg-(--highlight)/8 hover:pl-7"
          >
            <span class="font-mono text-sm text-text-primary transition-colors duration-200 group-hover:text-highlight">
              {link.label}
            </span>
            <span class="hidden font-mono text-xs text-(--text-tertiary) sm:block">
              {link.handle}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  @media (max-width: 639px) {
    :root {
      --marquee-duration: 15s;
    }
  }
</style>

<script>
  import { initTypewriter } from '@/scripts/typewriter';

  document.addEventListener('astro:page-load', () => {
    initTypewriter();
  });

  initTypewriter();
</script>
