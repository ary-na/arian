---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: import('astro').ImageMetadata;
  canonicalPath?: string;
  contentClass?: string;
  schema?: Record<string, unknown>;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image,
  canonicalPath,
  contentClass,
  schema,
  type,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      {title}
      {description}
      {image}
      {canonicalPath}
      {schema}
      {type}
      {publishedTime}
      {modifiedTime}
    />
  </head>
  <body class="flex min-h-screen flex-col pt-14">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-highlight focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-white focus:no-underline"
    >
      skip to content
    </a>
    <Header />
    <main id="main-content" class:list={['flex flex-1 flex-col', contentClass]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initScrollAnimations } from '@/scripts/scroll-animate';
  document.addEventListener('astro:page-load', initScrollAnimations);
  initScrollAnimations();
</script>
