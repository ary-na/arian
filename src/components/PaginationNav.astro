---
interface Props {
  currentPage: number;
  totalPages: number;
  hrefForPage: (page: number) => string;
}

const { currentPage, totalPages, hrefForPage } = Astro.props;

if (totalPages <= 1) {
  return null;
}

const progress = Math.round((currentPage / totalPages) * 100);
---

<nav aria-label="Pagination" class="mt-4 flex flex-col items-center gap-4">
  <div class="flex items-center gap-6">
    {
      currentPage > 1 ? (
        <a
          href={hrefForPage(currentPage - 1)}
          aria-label="Previous page"
          class="font-mono text-xs text-text-secondary no-underline transition-colors duration-200 hover:text-highlight"
        >
          ← prev
        </a>
      ) : (
        <span class="font-mono text-xs text-text-secondary/25 select-none">
          ← prev
        </span>
      )
    }

    <span class="font-mono text-xs text-text-secondary/60 tabular-nums">
      <span class="text-highlight">{currentPage}</span>
      <span class="mx-1 opacity-40">/</span>
      {totalPages}
    </span>

    {
      currentPage < totalPages ? (
        <a
          href={hrefForPage(currentPage + 1)}
          aria-label="Next page"
          class="font-mono text-xs text-text-secondary no-underline transition-colors duration-200 hover:text-highlight"
        >
          next →
        </a>
      ) : (
        <span class="font-mono text-xs text-text-secondary/25 select-none">
          next →
        </span>
      )
    }
  </div>

  <div class="w-32 h-px bg-(--text-secondary)/10 rounded-full overflow-hidden">
    <div
      class="h-full bg-highlight/60 rounded-full transition-all duration-500"
      style={`width: ${progress}%`}
    >
    </div>
  </div>
</nav>
