---
import { Image } from 'astro:assets';
import SiteLayout from '@layouts/SiteLayout.astro';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '@components/FormattedDate.astro';
import PaginationNav from './PaginationNav.astro';

type Post = CollectionEntry<'blog'>;

interface Props {
  archiveLabel: string;
  archiveTitle: string;
  countLabel: string;
  countNumber?: number;
  description: string;
  canonicalPath?: string;
  currentPage?: number;
  hrefForPage?: (page: number) => string;
  title: string;
  totalPages?: number;
  posts: Post[];
}

const {
  archiveLabel,
  archiveTitle,
  canonicalPath,
  countLabel,
  countNumber,
  currentPage = 1,
  description,
  hrefForPage,
  title,
  totalPages = 1,
  posts,
} = Astro.props;

const isFiltered = !!archiveTitle;
const gridPosts = posts;
---

<SiteLayout {title} {description} {canonicalPath}>
  <section class="page-container py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-3">
      {
        isFiltered && (
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 font-mono text-xs text-text-secondary no-underline transition-colors duration-200 hover:text-highlight w-fit"
          >
            ← all posts
          </a>
        )
      }
      <div class="flex flex-col gap-1.5">
        <span class="font-mono text-[10px] tracking-[0.2em] text-highlight/50"
          >blog /</span
        >
        <h1 class="text-4xl font-bold tracking-tight leading-none">
          {isFiltered ? archiveTitle : archiveLabel}
        </h1>
        <p class="font-mono text-[11px] text-(--text-secondary)/50 mt-0.5">
          {countLabel}{countNumber !== undefined && ` [${countNumber}]`}
        </p>
      </div>
    </div>

    {
      gridPosts.length > 0 && (
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {gridPosts.map((post, i) => (
            <li data-animate style={`--animate-delay: ${i * 50}ms`}>
              <a
                href={`/blog/${post.id}/`}
                class="group flex flex-col rounded-xl bg-(--bg-secondary) shadow-(--box-shadow) no-underline overflow-hidden transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 h-full"
              >
                {post.data.heroImage && (
                  <div class="overflow-hidden aspect-video sm:aspect-auto sm:h-40 shrink-0">
                    <Image
                      width={480}
                      height={200}
                      src={post.data.heroImage}
                      alt={post.data.heroImageAlt ?? post.data.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    />
                  </div>
                )}
                <div class="flex flex-col gap-3 p-6 flex-1">
                  {post.data.category && (
                    <span class="font-mono text-[10px] tracking-widest text-highlight opacity-90">
                      {post.data.category}
                    </span>
                  )}
                  <p class="font-mono text-sm leading-snug transition-colors group-hover:text-highlight line-clamp-2">
                    {post.data.title}
                  </p>
                  {post.data.description && (
                    <p class="font-mono text-xs text-text-secondary line-clamp-2 leading-relaxed">
                      {post.data.description}
                    </p>
                  )}
                  <span class="font-mono text-[11px] text-text-secondary/60 mt-auto pt-2">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      hrefForPage && (
        <PaginationNav
          currentPage={currentPage}
          totalPages={totalPages}
          hrefForPage={hrefForPage}
        />
      )
    }
  </section>
</SiteLayout>
