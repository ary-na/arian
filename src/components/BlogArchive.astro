---
import { Image } from 'astro:assets';
import SiteLayout from '@layouts/SiteLayout.astro';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '@components/FormattedDate.astro';
import PaginationNav from './PaginationNav.astro';

type Post = CollectionEntry<'blog'>;

interface Props {
  archiveLabel: string;
  archiveTitle: string;
  countLabel: string;
  countNumber?: number;
  description: string;
  canonicalPath?: string;
  currentPage?: number;
  hrefForPage?: (page: number) => string;
  title: string;
  totalPages?: number;
  posts: Post[];
}

const {
  archiveLabel,
  archiveTitle,
  canonicalPath,
  countLabel,
  countNumber,
  currentPage = 1,
  description,
  hrefForPage,
  title,
  totalPages = 1,
  posts,
} = Astro.props;

const isFiltered = !!archiveTitle;
---

<SiteLayout {title} {description} {canonicalPath}>
  <section class="page-container py-10 flex flex-col gap-6">

    <div class="flex flex-col gap-3">
      {isFiltered && (
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-mono text-xs text-text-secondary no-underline transition-colors duration-200 hover:text-highlight w-fit"
        >
          ← all posts
        </a>
      )}
      <div class="flex flex-col gap-1">
        <span class="font-mono text-xs tracking-widest text-text-secondary">
          {countLabel}
          {countNumber !== undefined && (
            <span class="text-highlight">[{countNumber}]</span>
          )}
        </span>
        <h1 class="flex text-3xl items-center gap-2 after:h-px after:flex-1">
          {isFiltered ? archiveTitle : archiveLabel}
        </h1>
      </div>
    </div>

    <ul class="flex flex-col gap-3">
      {posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}/`}
            class="group grid grid-cols-[1fr_auto] items-start gap-4 rounded-lg bg-(--bg-secondary) p-4 no-underline shadow-(--box-shadow) transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
          >
            <div class="flex min-w-0 flex-col gap-1.5">
              {post.data.category && (
                <span class="font-mono text-[10px] text-highlight opacity-90">
                  {post.data.category}
                </span>
              )}
              <p class="truncate font-mono text-sm transition-colors group-hover:text-highlight">
                {post.data.title}
              </p>
              {post.data.description && (
                <p class="font-mono text-xs text-text-secondary line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
              )}
              <span class="font-mono text-[11px] text-text-secondary/60">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </div>

            {post.data.heroImage && (
              <div class="shrink-0 hidden sm:block">
                <Image
                  width={320}
                  height={160}
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt ?? ''}
                  class="rounded object-cover w-[240px] h-[120px]"
                />
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>

    {hrefForPage && (
      <PaginationNav
        currentPage={currentPage}
        totalPages={totalPages}
        hrefForPage={hrefForPage}
      />
    )}
  </section>
</SiteLayout>
