---
import SiteLayout from '@layouts/SiteLayout.astro'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '@components/FormattedDate.astro'
import PaginationNav from './PaginationNav.astro'

type Post = CollectionEntry<'blog'>

interface Props {
  archiveLabel: string
  archiveTitle: string
  countLabel: string
  countNumber?: number
  description: string
  canonicalPath?: string
  currentPage?: number
  hrefForPage?: (page: number) => string
  title: string
  totalPages?: number
  posts: Post[]
}

const {
  archiveLabel,
  archiveTitle,
  canonicalPath,
  countLabel,
  countNumber,
  currentPage = 1,
  description,
  hrefForPage,
  title,
  totalPages = 1,
  posts,
} = Astro.props

const isFiltered = !!archiveTitle
const gridPosts = posts
---

<SiteLayout {title} {description} {canonicalPath}>
  <section class="page-container py-16 flex flex-col gap-8">
    <div class="flex flex-col gap-3">
      {
        isFiltered && (
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 font-mono text-xs text-text-secondary no-underline transition-colors duration-200 hover:text-highlight w-fit"
          >
            ← all posts
          </a>
        )
      }
      <div class="flex flex-col gap-2">
        <span class="font-mono text-xs text-highlight">blog</span>
        <h1 class="text-section font-semibold">
          {isFiltered ? archiveTitle : archiveLabel}
        </h1>
        <p class="font-mono text-xs text-text-tertiary">
          {countLabel}{countNumber !== undefined && ` [${countNumber}]`}
        </p>
      </div>
    </div>

    {
      gridPosts.length > 0 && (
        <ul class="flex flex-col divide-y divide-(--text-secondary)/10 border-t border-b border-(--text-secondary)/10">
          {gridPosts.map((post, i) => (
            <li data-animate style={`--animate-delay: ${i * 50}ms`}>
              <a
                href={`/blog/${post.id}/`}
                class="group flex flex-col sm:flex-row sm:items-baseline sm:gap-6 py-4 no-underline"
              >
                <span class="text-sm text-text-primary group-hover:text-highlight transition-colors flex-1">
                  {post.data.title}
                </span>
                {post.data.category && (
                  <span class="font-mono text-xs text-text-tertiary shrink-0 hidden sm:block">
                    {post.data.category}
                  </span>
                )}
                <span class="font-mono text-xs text-text-tertiary shrink-0">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      hrefForPage && (
        <PaginationNav
          currentPage={currentPage}
          totalPages={totalPages}
          hrefForPage={hrefForPage}
        />
      )
    }
  </section>
</SiteLayout>
