---
import { getCollection } from 'astro:content'
import { categoryHref, PRIMARY_NAV } from '@/consts'

const posts = await getCollection('blog')
const categories = [
  ...new Set(posts.flatMap((p) => p.data.category ?? [])),
].sort()

const pathname = Astro.url.pathname
---

<header class="fixed top-0 left-0 right-0 z-50">
  <div
    class="bg-surface-primary border-b border-(--text-secondary)/10 shadow-(--box-shadow)"
  >
    <div
      class="flex h-14 w-full items-center justify-between px-6 md:px-10 lg:px-16"
    >
      <a href="/" class="flex items-baseline gap-0.5 no-underline">
        <span
          class="font-display text-xl font-bold tracking-tight text-text-primary"
          >arii</span
        >
        <span
          class="font-display text-xl font-bold tracking-tight text-highlight"
          >.dev</span
        >
      </a>

      <nav class="hidden lg:flex items-center gap-5">
        {
          PRIMARY_NAV.map((item) => (
            <a
              href={item.href}
              class:list={[
                'font-mono text-xs no-underline transition-colors duration-200',
                pathname === item.href ||
                (item.href !== '/' && pathname.startsWith(item.href))
                  ? 'text-highlight'
                  : 'text-text-secondary hover:text-text-primary',
              ]}
            >
              {item.label.toLowerCase()}
            </a>
          ))
        }

        {
          categories.length > 0 && (
            <>
              <span class="h-3.5 w-px bg-(--text-secondary)/20" />
              {categories.map((cat) => (
                <a
                  href={categoryHref(cat)}
                  class:list={[
                    'font-mono text-xs no-underline transition-colors duration-200',
                    pathname.startsWith(categoryHref(cat))
                      ? 'text-highlight'
                      : 'text-text-secondary/60 hover:text-highlight',
                  ]}
                >
                  {cat}
                </a>
              ))}
            </>
          )
        }
      </nav>

      <button
        id="mobile-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="lg:hidden cursor-pointer relative flex h-9 w-9 items-center justify-center rounded-lg border border-(--text-secondary)/10 bg-(--bg-secondary) text-text-primary transition"
      >
        <span
          class="mobile-line mobile-line--top absolute block h-0.5 w-4 rounded-full bg-current transition-all duration-300 ease-out"
        ></span>
        <span
          class="mobile-line mobile-line--middle absolute block h-0.5 w-4 rounded-full bg-current transition-all duration-200 ease-out"
        ></span>
        <span
          class="mobile-line mobile-line--bottom absolute block h-0.5 w-4 rounded-full bg-current transition-all duration-300 ease-out"
        ></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden bg-surface-primary border-b border-(--text-secondary)/10"
  >
    <div class="py-3 flex flex-col gap-1 px-6 md:px-10 lg:px-16">
      {
        PRIMARY_NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-mono text-sm px-3 py-2.5 rounded-lg no-underline transition-all duration-200',
              pathname === item.href ||
              (item.href !== '/' && pathname.startsWith(item.href))
                ? 'text-highlight bg-(--highlight)/10'
                : 'text-text-secondary hover:text-text-primary hover:bg-(--bg-secondary)',
            ]}
          >
            {item.label.toLowerCase()}
          </a>
        ))
      }

      <div
        class="mt-2 border-t border-(--text-secondary)/10 pt-3 flex flex-col gap-2"
      >
        <span
          class="px-3 font-mono text-[10px] tracking-widest text-text-secondary/60 uppercase"
          >categories</span
        >
        <div class="flex flex-wrap gap-x-4 gap-y-2 px-3 pb-1">
          {
            categories.map((cat) => (
              <a
                href={categoryHref(cat)}
                class:list={[
                  'font-mono text-xs no-underline transition-colors duration-200',
                  pathname.startsWith(categoryHref(cat))
                    ? 'text-highlight'
                    : 'text-text-secondary hover:text-highlight',
                ]}
              >
                {cat}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-line {
    left: 50%;
    top: 50%;
    transform-origin: center;
    translate: -50% -50%;
  }

  .mobile-line--top {
    transform: translateY(-5px);
  }
  .mobile-line--middle {
    transform: translateY(0);
  }
  .mobile-line--bottom {
    transform: translateY(5px);
  }

  #mobile-menu {
    overflow: hidden;
    max-height: 0;
    transition: max-height 300ms ease;
  }

  #mobile-menu.is-open {
    max-height: var(--menu-height, 600px);
  }

  #mobile-toggle.is-open .mobile-line--top {
    transform: rotate(45deg);
  }
  #mobile-toggle.is-open .mobile-line--middle {
    transform: scaleX(0);
    opacity: 0;
  }
  #mobile-toggle.is-open .mobile-line--bottom {
    transform: rotate(-45deg);
  }
</style>

<script>
  const initHeader = () => {
    const toggle = document.getElementById(
      'mobile-toggle',
    ) as HTMLButtonElement | null
    const menu = document.getElementById('mobile-menu') as HTMLElement | null

    if (!toggle || !menu || toggle.dataset.bound === 'true') return
    toggle.dataset.bound = 'true'

    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open')
      toggle.classList.toggle('is-open', open)
      toggle.setAttribute('aria-expanded', String(open))
      menu.style.setProperty('--menu-height', menu.scrollHeight + 'px')
    })
  }

  document.addEventListener('astro:page-load', initHeader)
  initHeader()
</script>
