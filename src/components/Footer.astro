---
import { PRIMARY_NAV, SITE_AUTHOR } from '@/consts';

const today = new Date();

const SOCIAL_LINKS = [
  { href: 'https://github.com/ary-na', label: 'github' },
  { href: 'https://x.com/ariiii4n', label: 'x / twitter' },
  { href: 'https://linkedin.com/in/arian-najafi-yamchelo', label: 'linkedin' },
];
---

<footer class="mt-auto pt-7">
  <div class="h-px bg-gradient-to-r from-highlight via-primary to-transparent opacity-60"></div>
  <div class="page-container py-10">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="flex flex-col gap-2">
        <a href="/" class="flex items-baseline gap-0.5 no-underline">
          <span class="font-display text-xl font-bold tracking-tight text-text-primary">arii</span>
          <span class="font-display text-xl font-bold tracking-tight text-highlight">.dev</span>
        </a>
        <p class="font-mono text-xs text-(--text-secondary) max-w-48 leading-relaxed">
          code, AI, and things worth writing down.
        </p>
      </div>

      <div class="flex gap-12">
        <div class="flex flex-col gap-2.5">
          <span class="font-mono text-[10px] tracking-widest text-(--text-secondary)/60 uppercase">nav</span>
          {PRIMARY_NAV.map((item) => (
            <a
              href={item.href}
              class="font-mono text-xs text-(--text-secondary) no-underline transition-colors duration-200 hover:text-highlight"
            >
              {item.label}
            </a>
          ))}
        </div>

        <div class="flex flex-col gap-2.5">
          <span class="font-mono text-[10px] tracking-widest text-(--text-secondary)/60 uppercase">find me</span>
          {SOCIAL_LINKS.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs text-(--text-secondary) no-underline transition-colors duration-200 hover:text-highlight"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-1 border-t border-(--text-secondary)/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[10px] text-(--text-secondary)/60">
        &copy; {today.getFullYear()} {SITE_AUTHOR}. All rights reserved.
      </p>
      <p class="font-mono text-[10px] text-(--text-secondary)/40">built with astro</p>
    </div>
  </div>
</footer>
