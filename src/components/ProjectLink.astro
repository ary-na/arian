---
interface Props {
  demo?: string;
  github?: string;
  githubBackend?: string;
  npm?: string;
  trello?: string;
  email?: string;
  demoCrossed?: boolean;
  demoLabel?: string;
  githubLabel?: string;
  githubBackendLabel?: string;
  npmLabel?: string;
  trelloLabel?: string;
  emailLabel?: string;
}

const {
  demo,
  github,
  githubBackend,
  npm,
  trello,
  email,
  demoCrossed,
  demoLabel = 'live demo',
  githubLabel = 'github',
  githubBackendLabel = 'github backend',
  npmLabel = 'npm',
  trelloLabel = 'trello',
  emailLabel = 'email',
} = Astro.props;
---

<div class="my-4 flex flex-wrap gap-2 font-mono text-sm sm:gap-4">
  {
    demo && (
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="group text-text-secondary hover:text-text-primary no-underline transition-colors duration-200"
      >
        <span class="text-accent">[</span>
        <span class:list={[{ 'line-through': demoCrossed }]}>{demoLabel}</span>
        <span class="text-accent">]</span>
      </a>
    )
  }
  {
    github && (
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="group text-text-secondary hover:text-text-primary no-underline transition-colors duration-200"
      >
        <span class="text-accent">[</span>
        <span>{githubLabel}</span>
        <span class="text-accent">]</span>
      </a>
    )
  }
  {
    githubBackend && (
      <a
        href={githubBackend}
        target="_blank"
        rel="noopener noreferrer"
        class="group text-text-secondary hover:text-text-primary no-underline transition-colors duration-200"
      >
        <span class="text-accent">[</span>
        <span>{githubBackendLabel}</span>
        <span class="text-accent">]</span>
      </a>
    )
  }
  {
    npm && (
      <a
        href={npm}
        target="_blank"
        rel="noopener noreferrer"
        class="group text-text-secondary hover:text-text-primary no-underline transition-colors duration-200"
      >
        <span class="text-accent">[</span>
        <span>{npmLabel}</span>
        <span class="text-accent">]</span>
      </a>
    )
  }
  {
    trello && (
      <a
        href={trello}
        target="_blank"
        rel="noopener noreferrer"
        class="group text-text-secondary hover:text-text-primary no-underline transition-colors duration-200"
      >
        <span class="text-accent">[</span>
        <span>{trelloLabel}</span>
        <span class="text-accent">]</span>
      </a>
    )
  }
  {
    email && (
      <a
        href={`mailto:${email}`}
        class="group text-text-secondary hover:text-text-primary no-underline transition-colors duration-200"
      >
        <span class="text-accent">[</span>
        <span>{emailLabel}</span>
        <span class="text-accent">]</span>
      </a>
    )
  }
</div>
